@page "{id:int}"
@model UniversityWeb.Pages.Courses.DeleteModel
@{ ViewData["Title"] = "Delete course"; }
<h1>Delete course</h1>
<dl class="details">
    <dt>Course code</dt><dd>@Model.Item.Code</dd>
    <dt>Title</dt><dd>@Model.Item.Title</dd>
    <dt>Teacher</dt><dd>@Model.TeacherName</dd>
</dl>
<form method="post"><div asp-validation-summary="All" role="alert"></div><p>Confirm deletion of this record.</p><div class="actions"><button class="danger" type="submit">Confirm delete</button><a asp-page="Index">Cancel</a></div></form>
