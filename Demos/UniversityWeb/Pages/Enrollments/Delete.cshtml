@page "{id:int}"
@model UniversityWeb.Pages.Enrollments.DeleteModel
@{ ViewData["Title"] = "Delete enrollment"; }
<h1>Delete enrollment</h1>
<dl class="details">
    <dt>Student</dt><dd>@Model.StudentName</dd>
    <dt>Course</dt><dd>@Model.CourseName</dd>
    <dt>Enrolled on</dt><dd>@Model.Item.EnrolledOn.ToString("yyyy-MM-dd")</dd>
</dl>
<form method="post"><div asp-validation-summary="All" role="alert"></div><p>Confirm deletion of this record.</p><div class="actions"><button class="danger" type="submit">Confirm delete</button><a asp-page="Index">Cancel</a></div></form>
