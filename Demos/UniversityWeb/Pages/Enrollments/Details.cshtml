@page "{id:int}"
@model UniversityWeb.Pages.Enrollments.DetailsModel
@{ ViewData["Title"] = "Enrollment details"; }
<h1>Enrollment details</h1>
<dl class="details">
    <dt>Student</dt><dd>@Model.StudentName</dd>
    <dt>Course</dt><dd>@Model.CourseName</dd>
    <dt>Enrolled on</dt><dd>@Model.Item.EnrolledOn.ToString("yyyy-MM-dd")</dd>
</dl>
<div class="actions"><a asp-page="Edit" asp-route-id="@Model.Item.Id">Edit</a><a asp-page="Index">Back to list</a></div>
