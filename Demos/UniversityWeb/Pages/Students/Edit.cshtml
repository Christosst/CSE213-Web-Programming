@page "{id:int}"
@model UniversityWeb.Pages.Students.EditModel
@{ ViewData["Title"] = "Edit student"; }
<h1>Edit student</h1>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <div class="field">
        <label asp-for="Input.FullName"></label>
        <input asp-for="Input.FullName" />
        <span asp-validation-for="Input.FullName"></span>
    </div>
    <div class="field">
        <label asp-for="Input.RegistrationNumber"></label>
        <input asp-for="Input.RegistrationNumber" />
        <span asp-validation-for="Input.RegistrationNumber"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" type="email" />
        <span asp-validation-for="Input.Email"></span>
    </div>

    <div class="actions"><button type="submit">Save changes</button><a asp-page="Index">Cancel</a></div>
</form>
