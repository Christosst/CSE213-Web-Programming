<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
    <!-- The API and Razor app compile the same database model. -->
    <Compile Include="../UniversityApi/UniversityDb.cs" Link="Data/UniversityDb.cs" />
    <Compile Include="../UniversityApi/Models/Student.cs" Link="Models/Student.cs" />
    <Compile Include="../UniversityApi/Models/Teacher.cs" Link="Models/Teacher.cs" />
    <Compile Include="../UniversityApi/Models/Course.cs" Link="Models/Course.cs" />
    <Compile Include="../UniversityApi/Models/Enrollment.cs" Link="Models/Enrollment.cs" />
    <Compile Include="../UniversityApi/Models/CourseSection.cs" Link="Models/CourseSection.cs" />
  </ItemGroup>
</Project>
